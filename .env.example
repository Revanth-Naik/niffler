# Optional: enables Alpha Vantage ingestion (news/sentiment, fundamentals)
# Free tier: https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=

# Optional: gives Dumbledore a real LLM instead of the built-in template
# system. Groq has a genuinely free tier (no credit card) and works both
# locally and on the deployed app — get a key at https://console.groq.com
# On Streamlit Community Cloud, set this as a root-level entry in the
# app's "Secrets" settings instead of here; it reaches the app the same way.
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# Optional alternative to Groq: a local Ollama server (https://ollama.com).
# Only works when running Niffler locally with Ollama installed and
# running — Streamlit Community Cloud can't reach it. Used automatically
# if reachable and GROQ_API_KEY isn't set.
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.2
